VITE_AZTEC_NODE_URL=http://localhost:8080
VITE_PROVER_ENABLED=true

VITE_EMBEDDED_ACCOUNT_SECRET_PHRASE="my secret"
VITE_EMBEDDED_ACCOUNT_SECRET_KEY="0x..."
VITE_COMMON_SALT="1337"

# Deterministic salt for E2E testing - ensures consistent account addresses
# When set, embedded wallet accounts will use this salt instead of random bytes
# This allows tests to reuse already-deployed accounts
# VITE_E2E_DETERMINISTIC_SALT=0x00000000000000000000000000000000000000000000000000000000e2e7e57